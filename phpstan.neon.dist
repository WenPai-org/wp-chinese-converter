includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 1
    scanFiles:
        - includes/core/class-wpcc-exception-handler.php
        - includes/core/class-wpcc-main.php
        - includes/core/class-wpcc-module-manager.php
        - includes/core/class-wpcc-config.php
    paths:
        - wp-chinese-converter.php
        - includes/wpcc-core.php
        - includes/wpcc-admin.php
        - includes/wpcc-settings-page.php
        - includes/admin/class-wpcc-admin.php
        - includes/core/class-wpcc-conversion-cache.php
        - includes/core/class-wpcc-converter-factory.php
        - includes/core/class-wpcc-language-config.php
        - includes/core/class-wpcc-mediawiki-converter.php
        - includes/core/class-wpcc-opencc-converter.php
        - includes/core/class-wpcc-post-conversion-backup.php
        - includes/modules/wpcc-cache-addon.php
        - includes/modules/wpcc-modern-cache.php
        - includes/modules/wpcc-rest-api.php
        - includes/modules/wpcc-seo-enhancement.php
        - includes/modules/wpcc-sitemap.php
        - includes/network/wpcc-network-settings.php
    bootstrapFiles:
        - vendor/autoload.php
        - tests/phpstan-bootstrap.php
    excludePaths:
        analyse:
            - includes/core/ZhConversion.php
            - includes/core/simple_html_dom.php
    ignoreErrors:
        # This settings view is included from WPCC_Admin::settings_page(), so
        # PHP provides the controller as $this. PHPStan analyzes path entries
        # as standalone files and cannot model the include-time object scope.
        -
            message: '#Variable \$this might not be defined\.#'
            path: includes/wpcc-settings-page.php
    parallel:
        maximumNumberOfProcesses: 1
