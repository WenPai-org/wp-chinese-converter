{
    "name": "wpcc/wp-chinese-converter",
    "description": "WordPress Chinese Simplified/Traditional Converter Plugin",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "WPCC.NET",
            "homepage": "https://wpcc.net"
        }
    ],
    "require": {
        "php": ">=7.4",
        "overtrue/php-opencc": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "license": "GPL-3.0-or-later",
    "scripts": {
        "test": "phpunit",
        "check": [
            "composer validate --strict",
            "composer audit --locked",
            "@test"
        ],
        "analyze": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "cs": "phpcs --standard=phpcs.xml.dist"
    },
    "config": {
		"platform": {
			"php": "8.1.0"
		},
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
